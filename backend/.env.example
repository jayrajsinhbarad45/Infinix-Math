# Infinix Math - Backend Environment Configuration

# API Settings
PROJECT_NAME="Infinix Math"
API_V1_STR="/api/v1"
DEBUG=false
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","*"]

# SymPy Engine Safety Limits
SYMPY_TIMEOUT_SECONDS=4.0
MAX_AST_SIZE=250

# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
MOCK_GEMINI_FALLBACK=true
